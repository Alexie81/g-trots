Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
</IfModule>

<FilesMatch "^(config\.local\.php|config\.example\.php|gomag\.local\.php|gomag\.local\.example\.php|spv-runtime\.php|spv-cron\.php)$">
  Require all denied
</FilesMatch>
